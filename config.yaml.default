# ======================================================================
#  ablocker — Xray abuse blocker (torrents + malware/botnet)
#  Форк tblocker: банит торрент-абузеров И устройства с малварью/ботнетом.
# ======================================================================

# Путь к access.log ноды Xray/Remnawave.
LogFile: "/var/log/remnanode/access.log"

# --- Торрент-блокировка (как в tblocker) ---
# Требует включённого bittorrent-сниффинга в Xray и роутинга тега в blackhole.
TorrentTag: "TORRENT"
BlockDuration: 10           # минут — короткий бан за торрент

# iptables | nft
BlockMode: "iptables"

# Белый список: эти IP и подсети НИКОГДА не банятся (ни торрент, ни malware).
# Поддерживаются одиночные IP и CIDR-подсети. Переживает рестарт.
# BypassIPS:
#   - "203.0.113.10"        # одиночный IP (напр. твой личный/мониторинг)
#   - "10.8.0.0/16"          # целая подсеть

# --- Поведенческий детект торрентов (fan-out), v1.0.9+ ---
# Сниффинг Xray видит только НЕзашифрованный BitTorrent (по докам Remnawave это
# 10–30% торрент-трафика). qBittorrent/Transmission по умолчанию шифруют
# протокол и ходят по uTP — тег TORRENT на них не ставится, и скрипты по
# сигнатурам (в т.ч. рекомендованный хостером) их тоже не видят.
# Шифрование не прячет поведение: торрент-клиент за минуты подключается к
# сотням РАЗНЫХ пиров на случайных портах. Обычное устройство — к нескольким
# десяткам адресов, почти все на 443/80 и стандартных сервисных портах.
#
# Детектор считает для каждого юзера уникальные IP назначения (только голые IP,
# не домены) на НЕсервисных портах в скользящем окне. Веб, DNS, почта, пуши,
# STUN/TURN (звонки), Windows Update и т.п. не считаются.
#
# log = только строка в журнале "FANOUT: user=... ip=... peers=..."
#       (рекомендуется первые сутки — посмотреть, кого ловит);
# ban = бан IP как за торрент (на BlockDuration), в журнале
#       "User ... blocked for N minutes (torrent) [fanout: ...]".
# IP из BypassIPS не банятся никогда, но факт всё равно пишется в журнал.
FanoutEnabled: true
FanoutAction: "log"
FanoutThreshold: 150        # уникальных пиров за окно (торрент: 200–300+, обычные юзеры: до ~50)
FanoutWindow: "10m"
# Доп. порты, которые не считать (если легитимный сервис даёт ложняки):
# FanoutIgnorePorts: [27015]

# ======================================================================
#  Malware / botnet блокировка (Vo1d / BadBox и т.п.)
#  Ловим юзеров, чьи устройства стучатся на известные C2/ботнет-индикаторы.
# ======================================================================
MalwareBlockEnabled: true

# !!! ВАЖНО !!!
# Это malware/C2 фиды, а НЕ обычные блок-листы рекламы (типа domains_all.lst —
# он Vo1d/BadBox НЕ содержит). Проверь URL перед продакшеном.
MalwareDomainFeeds:
  - "https://urlhaus.abuse.ch/downloads/hostfile/"            # malware-домены (abuse.ch)
  - "https://threatfox.abuse.ch/downloads/hostfile/"
# Диапазоны, которые НИКОГДА не считаются malware-индикаторами (по адресу
# назначения). Cloudflare и публичные DNS уже исключены встроенно: за ними
# прячется малварь, но те же адреса обслуживают тысячи легитимных сайтов,
# и бан клиента за обращение туда — гарантированный ложняк.
# Здесь можно добавить свои (напр. IP собственных выходных нод):
# MalwareIPExclude:
#   - "203.0.113.0/24"

MalwareIPFeeds:
  - "https://feodotracker.abuse.ch/downloads/ipblocklist.txt" # botnet C2 IP (abuse.ch)
  - "https://cdn.jsdelivr.net/gh/elliotwutingfeng/ThreatFox-IOC-IPs@main/ips.txt" # все активные C2 IP из ThreatFox (~23k, зеркало обновляется ежечасно; jsDelivr доступен с РФ-нод)
  # SSLBL IP-блэклист закрыт abuse.ch 2025-01-03 (файл пустой) — удалён из дефолтов.

# Sinkhole-адреса: исследовательские "воронки" (Shadowserver, Microsoft, CERT
# и др.), на которые переведены отобранные у злоумышленников C2-домены.
# Здоровое устройство туда не обращается никогда, поэтому попадание = почти
# гарантированно заражённый клиент. Живые C2-фиды такие адреса не содержат
# (угроза уже обезврежена), так что это отдельный слой детекта.
# В логах помечаются как category=sinkhole.
SinkholeFeeds:
  - "https://cdn.jsdelivr.net/gh/brakmic/Sinkholes@main/Sinkholes_List.csv" # ~165 адресов и подсетей, обновляется

# ban     = длинный локальный бан IP на ЭТОЙ ноде (работает сразу, без вебхука).
# disable = + вебхук на панель, чтобы вырубить юзера на ВСЕХ нодах
#           (нужен включённый SendWebhook + WebhookURL ниже).
MalwareAction: "ban"
MalwareBlockDuration: 1440   # минут (24ч) — заражённый бокс иначе просто переподключится
BlocklistReload: "30m"       # как часто перечитывать фиды

# --- Прочее (как в tblocker) ---
# IgnoreEmail: false
# StorageDir: "/opt/ablocker"
# UsernameRegex: "^(.+)$"
# Hostname: ""

# --- Вебхук (нужен для MalwareAction: "disable") ---
# Шлёт POST на твой n8n/панель. Поля: username, ip, server, action, duration, timestamp.
# action принимает значения: block / unblock / malware_block / malware_disable
# SendWebhook: true
# WebhookURL: "https://your-n8n/webhook/ablocker"
# WebhookTemplate: '{"username":"%s","ip":"%s","server":"%s","action":"%s","duration":%d,"timestamp":"%s"}'
# WebhookHeaders:
#   Authorization: "Bearer xxx"
